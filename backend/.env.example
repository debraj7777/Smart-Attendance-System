# ─── Database ───────────────────────────────────────────────────────────────
# Set MONGO_URI for persistent storage (MongoDB Atlas or local).
# Atlas free tier: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/attendance?retryWrites=true&w=majority

# Set USE_IN_MEMORY_DB=true ONLY for local dev/testing without Atlas.
# Data is lost on every restart. Leave commented out in production.
# USE_IN_MEMORY_DB=true

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ─── Biometric Encryption ────────────────────────────────────────────────────
# 32-byte key as 64 hex chars — encrypts face descriptors at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DESCRIPTOR_ENCRYPTION_KEY=replace_with_64_hex_chars

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
